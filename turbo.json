{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    },
    "api#build": {
      "outputs": ["$TURBO_ROOT$/dist/api/**"]
    },
    "docs#build": {
      "outputs": ["$TURBO_ROOT$/dist/docs/**"]
    },
    "web#build": {
      "outputs": ["$TURBO_ROOT$/dist/web/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["api#build", "docs#build", "web#build"],
      "env": [
        "CI",
        "E2E_API_URL",
        "E2E_DOCS_URL",
        "E2E_INCLUDE_FIREFOX",
        "E2E_WEB_URL"
      ]
    },
    "dev": {
      "cache": false,
      "passThroughEnv": ["PORT"],
      "persistent": true
    }
  }
}
