{
  "name": "starter-turborepo-next-nest",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npjonath/starter-turborepo-next-nest.git"
  },
  "scripts": {
    "audit": "bun audit --audit-level=high",
    "build": "turbo run build",
    "check": "bun run format:check && bun run check:scripts && turbo run lint check-types test",
    "check:scripts": "node --check scripts/package-next.mjs && node --check scripts/start-api.mjs",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "docker:config": "docker compose config --quiet && docker compose -f compose.yaml -f compose.prod.yaml config --quiet",
    "docker:dev": "docker compose up --build --watch",
    "docker:down": "docker compose down --remove-orphans",
    "docker:prod": "docker compose -f compose.yaml -f compose.prod.yaml up --build --detach --wait",
    "docker:prod:down": "docker compose -f compose.yaml -f compose.prod.yaml down --remove-orphans",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:install": "bun run --cwd apps/e2e test:e2e:install",
    "test:e2e:ui": "bun run build && bun run --cwd apps/e2e test:e2e:ui",
    "typecheck": "bun run check-types"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.3.14",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
