{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "imports": {
    "#components/*": "./components/*.tsx",
    "#hooks/*": "./hooks/*.ts",
    "#lib/*": "./lib/*.ts"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:docker": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build && bun ../../scripts/package-next.mjs web",
    "start": "node ../../dist/web/apps/web/server.js",
    "start:prod": "node ../../dist/web/apps/web/server.js",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@repo/ui": "*",
    "next": "16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "^10.10.0",
    "typescript": "6.0.3"
  }
}
